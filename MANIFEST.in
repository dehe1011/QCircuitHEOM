# Include the README, LICENSE, and other documentation files
include README.md
include LICENSE.txt
include CITATION.bib

# Include requirement files (read by pyproject.toml)
include requirements/*.txt

# Package data
include qcheom/*.mplstyle
include qcheom/gui/logo.png

# Exclude editor/notebook artifacts
global-exclude *.py[cod] __pycache__ .ipynb_checkpoints
prune qcheom/**/.ipynb_checkpoints
prune qcheom/.ipynb_checkpoints
